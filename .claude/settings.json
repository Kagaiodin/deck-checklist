{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git rev-list *)",
      "Bash(git ls-files*)",
      "Bash(git check-ignore *)",
      "Bash(git fetch*)",
      "Bash(git branch --list*)",
      "Bash(git branch --show-current)",
      "Bash(git branch -vv)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git checkout main)",
      "Bash(git checkout feat/*)",
      "Bash(git checkout fix/*)",
      "Bash(git checkout chore/*)",
      "Bash(git pull --ff-only*)",
      "Bash(gh issue view *)",
      "Bash(gh issue list*)",
      "Bash(gh pr view *)",
      "Bash(gh pr list*)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh run list*)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(npm test)",
      "Bash(npm test *)",
      "Bash(npm run build)",
      "Bash(npm run test*)",
      "Bash(npm run lint)",
      "Bash(npm run verify)",
      "Bash(npm run css:index)",
      "Bash(npm run -s css:index)",
      "Bash(npm run dev)",
      "Bash(npm run screenshots*)",
      "Bash(npx vitest *)",
      "Bash(npx tsc *)",
      "Bash(npx playwright *)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -s -o /dev/null -w * http://localhost:*)",
      "Bash(pkill -f \"vite\")",
      "Bash(open http://localhost:*)",
      "Skill(run)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -f*)",
      "Bash(npm run deploy*)",
      "Bash(npx wrangler deploy*)",
      "Bash(wrangler deploy*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-main.sh",
            "if": "Bash(git *)",
            "statusMessage": "Checking branch..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-push-gate.sh",
            "if": "Bash(git push *)",
            "timeout": 300,
            "statusMessage": "Running build and tests before push..."
          }
        ]
      }
    ]
  }
}
