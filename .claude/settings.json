{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-main.sh",
            "if": "Bash(git *)",
            "statusMessage": "Checking branch..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-push-gate.sh",
            "if": "Bash(git push *)",
            "timeout": 300,
            "statusMessage": "Running build and tests before push..."
          }
        ]
      }
    ]
  }
}
